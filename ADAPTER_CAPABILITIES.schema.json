{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tngkrwlsmd/universal-agent-docs/ADAPTER_CAPABILITIES.schema.json",
  "title": "universal-agent-docs adapter capability declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "adapter_id",
    "supported_operations"
  ],
  "properties": {
    "format": {
      "const": "universal-agent-docs-adapter-capabilities-v1"
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "supported_operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]*$"
      }
    }
  }
}
