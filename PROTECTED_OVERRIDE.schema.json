{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PROTECTED_OVERRIDE.schema.json",
  "title": "universal-agent-docs protected override assertion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "override_id",
    "issuer",
    "issued_at",
    "expires_at",
    "scope",
    "operations",
    "targets",
    "environment",
    "correlation_id",
    "execution_nonce",
    "action_digest",
    "single_use",
    "authorization_reference"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "override_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "issued_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "expires_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]*$"
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "environment": {
      "enum": [
        "local",
        "test",
        "staging",
        "production",
        "public",
        "external",
        "unknown"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "execution_nonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "action_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "single_use": {
      "const": true
    },
    "authorization_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  }
}
