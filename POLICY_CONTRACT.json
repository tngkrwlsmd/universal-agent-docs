{
  "schema_version": 16,
  "project_name": "universal-agent-docs",
  "authority": {
    "root_router": "AGENTS.md",
    "human_policy_source": "POLICIES.md",
    "project_facts_source": "PROJECT.md",
    "conflict_rule": "Machine-enforceable rules are normative in POLICY_CONTRACT.json. Bundle validation fail-closes on explicit machine-readable/schema/implementation parity checks. Human-policy prose that conflicts with enforcement must be treated as invalid once detected and reconciled, but the validator does not claim to semantically parse every sentence in POLICIES.md.",
    "machine_policy_source": "POLICY_CONTRACT.json",
    "enforcement_conflict_behavior": "FAIL_CLOSED",
    "prose_validation_scope": "EXPLICIT_PARITY_CHECKS_ONLY"
  },
