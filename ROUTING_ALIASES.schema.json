{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "universal-agent-docs routing alias hints",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "normalization",
    "operations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "normalization": {
      "const": "nfkc_casefold_token_boundary_v3"
    },
    "operations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phrases",
          "stems",
          "patterns"
        ],
        "properties": {
          "phrases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "stems": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "patterns": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
