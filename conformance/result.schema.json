{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conformance/result.schema.json",
  "title": "universal-agent-docs conformance result protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conformance_version",
    "implementation",
    "summary",
    "results"
  ],
  "properties": {
    "conformance_version": {
      "type": "integer"
    },
    "implementation": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "passed",
        "failed"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "observed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "observed": {
            "type": "object"
          },
          "mismatches": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
