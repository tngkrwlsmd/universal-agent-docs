{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tngkrwlsmd/universal-agent-docs/conformance/corpus.schema.json",
  "title": "universal-agent-docs language-neutral conformance corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "policy_schema_version",
    "vectors"
  ],
  "properties": {
    "format": {
      "const": "universal-agent-docs-conformance-v2"
    },
    "schema_version": {
      "const": 2
    },
    "policy_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "category",
          "kind",
          "covers",
          "input",
          "expected",
          "normative_fields"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "routing",
              "execution_boundary",
              "digest_relation",
              "catalog_invariant",
              "approval",
              "protected_override",
              "readiness",
              "distribution",
              "integrity"
            ]
          },
          "covers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "input": {
            "type": "object"
          },
          "expected": {
            "type": "object"
          },
          "normative_fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
